{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dmi-workspace",
  "main": "server/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "enable_nodejs_http_server_modules"],
  "workers_dev": true,
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/assets/*", "/.well-known/*"]
  },
  "vars": { "DMS_RUNTIME": "cloudflare", "CLOUD_STORAGE_ONLY": "1", "TURNSTILE_REQUIRED": "0", "SITE_LOCKED": "0",
    "CF_ACCOUNT_ID": "c0cc9b55ee92823b9c517d39cb3fc01b", "CF_D1_DATABASE_ID": "9ad2e189-4940-4d8d-8b71-ccec235311ff" },
  "alias": { "node:sqlite": "./server/no-local-sqlite.ts" },
  "d1_databases": [{ "binding": "DB", "database_name": "dmi-studio-db", "database_id": "9ad2e189-4940-4d8d-8b71-ccec235311ff" }],
  // Files sent in Tin nhắn (server/chat-files.ts), private: served only through the app.
  "r2_buckets": [{ "binding": "CHAT_FILES", "bucket_name": "dmi-chat-files" }],
  // Ma Sói in 3D: one Durable Object per room relays where everyone is in the village (server/boardgame-live.ts).
  "durable_objects": { "bindings": [{ "name": "BG_ROOMS", "class_name": "BoardgameRoom" }] },
  "migrations": [{ "tag": "boardgame-rooms", "new_sqlite_classes": ["BoardgameRoom"] }],
  // Floods and spam turned away before the database (server/edge-limits.ts): per address, sign-ins per address, changes
  // and chat messages per session.
  "ratelimits": [
    { "name": "API_LIMIT", "namespace_id": "1001", "simple": { "limit": 600, "period": 60 } },
    { "name": "AUTH_LIMIT", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
    { "name": "WRITE_LIMIT", "namespace_id": "1003", "simple": { "limit": 300, "period": 60 } },
    { "name": "CHAT_LIMIT", "namespace_id": "1004", "simple": { "limit": 10, "period": 10 } }
  ],
  "build": { "command": "npm run build" },
  "observability": { "enabled": true },
  "triggers": {"crons":["* * * * *"]},
  "keep_vars": true
}
