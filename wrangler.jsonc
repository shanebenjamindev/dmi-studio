{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dmi-workspace",
  "main": "server/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "enable_nodejs_http_server_modules"],
  "workers_dev": true,
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/assets/*", "/.well-known/*"]
  },
  "vars": { "DMS_RUNTIME": "cloudflare", "CLOUD_STORAGE_ONLY": "1", "TURNSTILE_REQUIRED": "0", "SITE_LOCKED": "0",
    "CF_ACCOUNT_ID": "c0cc9b55ee92823b9c517d39cb3fc01b", "CF_D1_DATABASE_ID": "9ad2e189-4940-4d8d-8b71-ccec235311ff" },
  "alias": { "node:sqlite": "./server/no-local-sqlite.ts" },
  "d1_databases": [{ "binding": "DB", "database_name": "dmi-studio-db", "database_id": "9ad2e189-4940-4d8d-8b71-ccec235311ff" }],
  "build": { "command": "npm run build" },
  "observability": { "enabled": true },
  "triggers": {"crons":["* * * * *"]},
  "keep_vars": true
}
