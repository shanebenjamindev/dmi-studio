{
  "name": "dm-studio",
  "version": "2.0.0",
  "private": true,
  "description": "DMI Workspace — video maker for Detailers Movement. Scripts written by Claude Code CLI (no API keys).",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "npm run build && tsx server/index.ts",
    "serve": "tsx server/index.ts",
    "demo": "npm run build && cross-env DMS_MOCK=1 tsx server/index.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "node --import tsx --test tests/*.test.mjs",
    "dms": "tsx scripts/dms.ts",
    "cf:dev": "wrangler dev",
    "cf:check": "wrangler deploy --dry-run",
    "cf:deploy": "wrangler deploy",
    "cf:login": "wrangler login",
    "test:worker": "wrangler deploy --dry-run --outdir .wrangler/test-bundle && node --test tests/worker.test.mjs",
    "cf:secrets": "tsx scripts/cloudflare-secrets.ts",
    "db:backup": "wrangler d1 export dmi-studio-db --remote --output data/backups/d1-latest.sql"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@mediabunny/mp3-encoder": "1.61.6",
    "ffmpeg-static": "^5.2.0",
    "gifenc": "1.0.3",
    "mediabunny": "1.61.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "^4.23.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261031.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "cross-env": "^7.0.3",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20261023.3-beta",
    "typescript": "^5.6.0",
    "wrangler": "^4.156.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.2.0": true
  }
}
