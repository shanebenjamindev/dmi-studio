# DM Studio — sao chép thành .env rồi điền key bạn có (không bắt buộc đủ tất cả).
# Cũng có thể nhập key ngay trong ứng dụng: ⚙︎ Cài đặt.

# ── AI viết kịch bản ──────────────────────────────
ANTHROPIC_API_KEY=          # Claude   · https://console.anthropic.com
OPENAI_API_KEY=             # GPT + GPT Image + OpenAI TTS · https://platform.openai.com/api-keys
OPENROUTER_API_KEY=         # Gemini, DeepSeek, Llama… qua 1 key · https://openrouter.ai

# ── AI tạo video / ảnh ────────────────────────────
ARK_API_KEY=                # Seedance (BytePlus ModelArk)
# ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
HIGGSFIELD_API_KEY=         # dạng KEY_ID:KEY_SECRET · https://docs.higgsfield.ai
FAL_KEY=                    # fal.ai: Kling, Veo, Seedance, FLUX… · https://fal.ai

# ── Server ────────────────────────────────────────
PORT=5173
# HOST=127.0.0.1            # đổi thành 0.0.0.0 để máy khác trong mạng LAN truy cập
# ALLOWED_HOSTS=            # tên miền thêm được phép truy cập (phân cách bằng dấu phẩy), vd. studio.lan
# DATA_DIR=data             # nơi lưu SQLite + file media
# PUBLIC_URL=https://dm-studio.example.com # URL chung khi triển khai cloud
# SETUP_CODE=               # mã bảo vệ bước tạo admin đầu tiên trên cloud
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=         # token chỉ đặt ở backend, không đưa vào frontend hay Git
# CLOUD_STORAGE_ONLY=1      # Render Free: chỉ lưu file trên Google Drive
# DMS_MOCK=1                # bật nhà cung cấp demo (không cần key, cần ffmpeg)
