# DM Studio — sao chép thành .env nếu cần đổi cấu hình.

# ── AI viết kịch bản ──────────────────────────────
# Không cần API key: DM Studio gọi lệnh claude (Claude Code) bằng tài khoản Claude đã đăng nhập.
# CLAUDE_CLI_PATH=          # đường dẫn tới lệnh claude nếu không tự tìm thấy

# ── Server ────────────────────────────────────────
PORT=5173
# HOST=127.0.0.1            # đổi thành 0.0.0.0 để máy khác trong mạng LAN truy cập
# ALLOWED_HOSTS=            # tên miền thêm được phép truy cập (phân cách bằng dấu phẩy), vd. studio.lan
# DATA_DIR=data             # nơi lưu SQLite + file media
# PUBLIC_URL=https://dm-studio.example.com # URL chung khi triển khai cloud
# SETUP_CODE=               # mã bảo vệ bước tạo admin đầu tiên trên cloud
# CLOUD_STORAGE_ONLY=1      # cloud: chỉ lưu file trên Google Drive
# DMS_MOCK=1                # bật nhà cung cấp demo (không cần key, cần ffmpeg)

# Cloudflare Turnstile: tạo widget Managed cho hostname của app.
# TURNSTILE_SITE_KEY=       # key công khai của widget
# TURNSTILE_SECRET_KEY=     # chỉ ở backend / Cloudflare Secrets
